# База данных PostgreSQL (Neon / Supabase / локальный PostgreSQL)
# Для бесплатного облачного PostgreSQL создайте проект на https://neon.tech
# Пример формата: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Уведомления в Telegram (необязательно)
# 1. Создайте бота через @BotFather в Telegram и получите токен бота
# 2. Получите ваш chat_id или ID группы/канала (например через @userinfobot)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Публичный URL сайта (для канонических ссылок и Open Graph)
NEXT_PUBLIC_SITE_URL=https://kvartacoffee.by
